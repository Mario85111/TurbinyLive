# ── DEV: klucz czytany po stronie serwera (proxy Vite w vite.config.js) ──
# Brak prefiksu VITE_ jest celowy — dzięki temu Vite nie może wstrzyknąć klucza
# do bundla wysyłanego do przeglądarki.
# Darmowy klucz: https://home.openweathermap.org/api_keys
# (aktywacja nowego klucza może potrwać do ~2 godzin).
OPENWEATHER_API_KEY=

# ── PRODUKCJA: adres Cloudflare Workera, który dokłada klucz ──
# To publiczny URL, nie sekret. Zostaw pusty w dev — wtedy używane jest proxy Vite.
# Ustaw przed `npm run build`, np.:
# VITE_API_BASE=https://turbiny-live-owm.twoj-subdomena.workers.dev/api/owm
VITE_API_BASE=
